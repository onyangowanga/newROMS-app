    "test": "npm --prefix server test && playwright test"
  },
  "devDependencies": {
    "@playwright/test": "^1.63.0",
    "esbuild": "^0.28.2",
    "lucide": "^1.52.0",
    "tailwindcss": "^3.4.17"
  }
}
